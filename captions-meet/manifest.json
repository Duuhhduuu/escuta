{
  "manifest_version": 3,
  "name": "Escuta Legendas (Meet)",
  "short_name": "Legendas Meet",
  "version": "0.1.0",
  "description": "Guarda a transcrição do Google Meet pelas legendas do próprio Meet. Tudo fica neste navegador: sem conta, sem servidor, sem telemetria.",
  "permissions": ["storage"],
  "host_permissions": ["*://meet.google.com/*-*-*"],
  "content_scripts": [
    {
      "matches": ["*://meet.google.com/*-*-*"],
      "js": ["dist/page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://meet.google.com/*-*-*"],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Legendas do Meet" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
