# Copie para .env e preencha. O arquivo .env nunca vai para o git.

# Resumos pelo Gemini (nuvem). Com a chave preenchida, o Ollama nem é usado.
# Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional. Padrão: gemini-flash-lite-latest
# GEMINI_MODEL=gemini-flash-lite-latest

# Opcional: segredo compartilhado. Com ele preenchido, só quem mandar o mesmo
# valor no cabeçalho X-Escuta-Token fala com o servidor. Cole o mesmo texto no
# campo "Token do servidor" do ícone da extensão.
# Gere um: python -c "import secrets;print(secrets.token_urlsafe(24))"
# ESCUTA_TOKEN=

# Opcional (faster-whisper). Padrão: cuda quando disponível, senão cpu.
# ESCUTA_DEVICE=cpu
# ESCUTA_COMPUTE=int8
# Quantos trechos de audio a GPU processa de uma vez. Mais = mais rapido e mais VRAM.
# Padrão: 16. Baixe para 8 ou 4 se a placa tiver pouca memória.
# ESCUTA_BATCH=16
# O modelo carrega no boot e segura ~2 GB de VRAM. Ponha 0 para carregar
# só na primeira transcrição (libera a placa, custa uns 5s na primeira vez).
# ESCUTA_PRELOAD=0
