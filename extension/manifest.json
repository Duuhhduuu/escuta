{
  "manifest_version": 3,
  "name": "Escuta",
  "version": "1.9.0",
  "description": "Transcreve e resume mensagens de voz do WhatsApp Web, tudo local na sua máquina.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "tabCapture", "offscreen", "scripting"],
  "web_accessible_resources": [
    { "resources": ["live.html"], "matches": ["<all_urls>"] },
    { "resources": ["fonts/*.woff2"], "matches": ["https://web.whatsapp.com/*"] }
  ],
  "host_permissions": ["http://127.0.0.1:8765/*", "https://meet.google.com/*"],
  "background": { "service_worker": "background.js", "scripts": ["rec-db.js", "background.js", "meetings.js"] },
  "browser_specific_settings": {
    "gecko": { "id": "escuta@local", "strict_min_version": "128.0" }
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["meet-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["meet-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Escuta",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
